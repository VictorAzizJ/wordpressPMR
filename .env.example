# Google Apps Script web app URL that appends camp registrations to a Sheet
# and sends a confirmation email via MailApp (see scripts/camp-registration-apps-script.js).
# Server-only — never expose this to the client. When unset, /api/camp/register
# logs the payload and returns success with mode: "stub" (safe for local demo).
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional HMAC secret for camp form challenge tokens. Falls back to the
# webhook URL when unset. Use a dedicated random string in production.
CAMP_FORM_SECRET=

# Optional shared secret sent to Apps Script. If set, also add the same value
# as script property WEBHOOK_SECRET (Project Settings → Script properties).
CAMP_WEBHOOK_SECRET=

# Optional Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile).
# When both are set, the camp form shows a verification widget and the API
# rejects submissions without a valid token. Strongly recommended in production.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional override for the homepage updates grid.
# Defaults to the Behold URL in config/social.ts when unset.
# Do not put Meta / Instagram Graph tokens here — keep those server-only if added later.
UPDATES_FEED_URL=
